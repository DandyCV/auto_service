<% content_for :title, t("pages.about.title") %>
<% content_for :meta_description, t("pages.about.meta_description") %>

<section class="page">
  <div class="container">
    <div class="page-hero fade-in">
      <p class="page-eyebrow"><%= t("pages.about.hero.eyebrow") %></p>
      <h1><%= t("pages.about.hero.title") %></h1>
      <p class="page-hero__lede"><%= t("pages.about.hero.lede") %></p>
    </div>

    <div class="page-layout page-layout--split fade-in">
      <article class="page-panel">
        <h2><%= t("pages.about.who_we_are.title") %></h2>
        <p class="page-panel__lede"><%= t("pages.about.who_we_are.lede") %></p>
        <ul class="equipment-list">
          <% t("pages.about.who_we_are.points").each do |point| %>
            <li><%= point %></li>
          <% end %>
        </ul>
      </article>

      <article class="page-panel">
        <h2><%= t("pages.about.how_we_work.title") %></h2>
        <p class="page-panel__lede"><%= t("pages.about.how_we_work.lede") %></p>
        <ul class="equipment-list">
          <% t("pages.about.how_we_work.points").each do |point| %>
            <li><%= point %></li>
          <% end %>
        </ul>
      </article>
    </div>
  </div>
</section>
